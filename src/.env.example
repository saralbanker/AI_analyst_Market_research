# ===== Core =====

APP_ENV=development

DATABASE_URL=

# ===== Market Data =====

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=

# ===== News =====

FINNHUB_API_KEY=

# ===== Macro =====

TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_SECRET=

# ===== Governance =====

AUDIT_CHAIN_ENABLED=true
GOVERNANCE_ENABLED=true

# ===== Safety =====

PAPER_TRADING_ENABLED=true
AUTO_EXECUTION_ENABLED=false
BROKER_EXECUTION_ENABLED=false

# ===== Optional Fallback Providers =====

ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# ===== Dhan (CAP-02 independent second market-data vendor) =====
# Option A (simple): paste the access token from api.dhan.co directly.
#   The client_id is extracted automatically from the token's JWT payload.
#   Re-paste after each manual token refresh.
#
# Option B (automated): set DHAN_CLIENT_ID + DHAN_CLIENT_SECRET and let
#   scripts/generate_dhan_token.py + systemd/dhan-token-refresh.timer
#   rotate the token daily into secrets/dhan_token.json.

DHAN_API_KEY=
DHAN_CLIENT_ID=
DHAN_CLIENT_SECRET=
